# ==============================================================================
# SwanPanel - Production Environment Configuration
# Copy to /etc/swan-panel/swan-panel.env with permissions 600
# ==============================================================================

# Web Control Plane & REST API Port (default: 8080)
PORT=8080

# Split-DNS Resolver Port (default: 53)
DNS_PORT=53

# Enable or disable the internal Split-DNS engine (default: true)
ENABLE_DNS=true

# Persistent SQLite database storage path
DB_PATH=/var/lib/swan-panel/swanpanel.db

# Path to the strongSwan charon VICI UNIX socket
VICI_SOCKET=/var/run/charon.vici

# Runtime environment (production | development)
ENVIRONMENT=production

# Structured logging level (DEBUG | INFO | WARN | ERROR)
LOG_LEVEL=INFO

# Cryptographic Secret for JWT token authentication (32+ characters)
# Generate a new key with: head -c 32 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 32
JWT_SECRET=replace-with-a-secure-random-32-char-secret-in-production
