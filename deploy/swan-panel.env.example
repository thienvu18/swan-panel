# ==============================================================================
# SwanPanel - Production Environment Configuration
# Copy to /etc/swan-panel/swan-panel.env with permissions 600
# ==============================================================================

# Web Control Plane & REST API Port (default: 8080)
PORT=8080

# Split-DNS Resolver Port (default: 53)
DNS_PORT=53

# Enable or disable the internal Split-DNS engine (default: true)
ENABLE_DNS=true

# Persistent SQLite database storage path
DB_PATH=/var/lib/swan-panel/swanpanel.db

# Path to the strongSwan charon VICI UNIX socket
VICI_SOCKET=/var/run/charon.vici

# Required for native systemd with host charon; not used by default Docker Compose.
SWANPANEL_EXTERNAL_STRONGSWAN=1

# Runtime environment (production | development)
ENVIRONMENT=production

# Public HTTPS base URL (required for real OIDC callback URLs)
PUBLIC_URL=https://vpn-admin.example.com

# Optional; default is DB_PATH + ".setup-token" and mode 0600
# BOOTSTRAP_TOKEN_FILE=/var/lib/swan-panel/setup-token

# Keep Root CA, SQLite database, and MFA keystore on persistent, root-only storage
PKI_DATA_DIR=/var/lib/swan-panel

# Independent MFA TOTP encryption key file (0600, defaults to DB_PATH + ".mfa-key")
# Legacy deployments with JWT_SECRET-encrypted TOTP secrets migrate automatically on startup.
# MFA_KEY_FILE=/var/lib/swan-panel/swanpanel.db.mfa-key

# Explicit private HTTPS destinations permitted for alert webhooks (no wildcards, HTTPS only)
# Loopback, link-local metadata, multicast, and unspecified addresses remain blocked even if allowlisted.
# WEBHOOK_ALLOWED_DESTINATIONS=

# Structured logging level (DEBUG | INFO | WARN | ERROR)
LOG_LEVEL=INFO

# Cryptographic Secret for JWT token authentication (32+ characters)
# Generate a new key with: head -c 32 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 32
JWT_SECRET=replace-with-a-secure-random-32-char-secret-in-production
