# ==============================================================================
# SwanPanel - Environment Configuration Example
# Copy this file to .env to customize your deployment.
# ==============================================================================

# Web Control Plane HTTP Port (default: 8080)
PORT=8080

# Split-DNS Port on Host (default: 53)
# Note: On macOS or Linux VPS with systemd-resolved, port 53 may be bound by the OS.
# Change to 1053 or an alternate port for local development/testing.
HOST_DNS_PORT=53

# strongSwan IPsec IKEv2 Ports
IKE_PORT=500
IPSEC_PORT=4500

# Security & Authentication
# Replace with a strong, random 32+ character string in production
JWT_SECRET=swanpanel-change-in-production-random-secret-key

# Application Environment (production / development)
ENVIRONMENT=production
LOG_LEVEL=info

# Optional: Root CA subject ONLY for brand-new installations, before the CA exists.
# Existing CAs are never renamed or rotated automatically.
# CA_COMMON_NAME=SwanPanel Internal Root CA
# CA_ORGANIZATION=SwanPanel Root Authority
# CA_COUNTRY=US
# CA_PROVINCE=California
# CA_LOCALITY=San Francisco

# Optional distribution-specific strongSwan systemd service name.
# STRONGSWAN_SYSTEMD_UNIT=strongswan

# Optional path for SwanPanel-managed strongSwan connections and pools.
# Must be included from the daemon's swanctl.conf and writable by SwanPanel.
# SWANPANEL_SWANCTL_FILE=/etc/swanctl/conf.d/swanpanel-gateway.conf

# Optional: strongSwan credential and CRL directories for nonstandard installs.
# Keep all paths writable only by the trusted SwanPanel/strongSwan administrator.
# SWANPANEL_SWANCTL_DIR=/etc/swanctl
# SWANPANEL_SWANCTL_CRL_DIR=/etc/swanctl/x509crl

# Optional: custom strongSwan charon PID path for live daemon metrics.
# SWANPANEL_CHARON_PID_FILE=/run/charon.pid
