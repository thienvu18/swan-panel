# ==============================================================================
# SwanPanel - Environment Configuration Example
# Copy this file to .env to customize your deployment.
# ==============================================================================

# Web Control Plane HTTP Port (default: 8080)
PORT=8080

# Split-DNS Port on Host (default: 53)
# Note: On macOS or Linux VPS with systemd-resolved, port 53 may be bound by the OS.
# Change to 1053 or an alternate port for local development/testing.
HOST_DNS_PORT=53

# strongSwan IPsec IKEv2 Ports
IKE_PORT=500
IPSEC_PORT=4500

# Security & Authentication
# Replace with a strong, random 32+ character string in production
JWT_SECRET=swanpanel-change-in-production-random-secret-key

# Application Environment (production / development)
ENVIRONMENT=production
LOG_LEVEL=info
