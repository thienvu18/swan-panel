<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadDisplayName</key>
	<string>SwanPanel VPN (david-iphone-16-pro)</string>
	<key>PayloadIdentifier</key>
	<string>com.swanpanel.vpn.david-iphone-16-pro</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>swanpanel-vpn-david-iphone-16-pro</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadContent</key>
	<array>
		<!-- Root CA Certificate Payload -->
		<dict>
			<key>PayloadType</key>
			<string>com.apple.security.root</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>com.swanpanel.ca.david-iphone-16-pro</string>
			<key>PayloadUUID</key>
			<string>swanpanel-ca-david-iphone-16-pro</string>
			<key>PayloadDisplayName</key>
			<string>SwanPanel Root CA</string>
			<key>PayloadContent</key>
			<data></data>
		</dict>
		<!-- Client Certificate Payload -->
		<dict>
			<key>PayloadType</key>
			<string>com.apple.security.pem</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>com.swanpanel.cert.david-iphone-16-pro</string>
			<key>PayloadUUID</key>
			<string>swanpanel-client-david-iphone-16-pro</string>
			<key>PayloadDisplayName</key>
			<string>SwanPanel Client Certificate (david-iphone-16-pro)</string>
			<key>PayloadContent</key>
			<data></data>
		</dict>
		<!-- Native IKEv2 VPN Payload -->
		<dict>
			<key>PayloadType</key>
			<string>com.apple.vpn.managed</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>com.swanpanel.vpn.config.david-iphone-16-pro</string>
			<key>PayloadUUID</key>
			<string>swanpanel-ikev2-david-iphone-16-pro</string>
			<key>PayloadDisplayName</key>
			<string>SwanPanel IKEv2 (david-iphone-16-pro)</string>
			<key>UserDefinedName</key>
			<string>SwanPanel VPN</string>
			<key>VPNType</key>
			<string>IKEv2</string>
			<key>IKEv2</key>
			<dict>
				<key>RemoteAddress</key>
				<string>swan-panel</string>
				<key>RemoteIdentifier</key>
				<string>swan-panel</string>
				<key>LocalIdentifier</key>
				<string>david-iphone-16-pro</string>
				<key>AuthenticationMethod</key>
				<string>Certificate</string>
				<key>PayloadCertificateUUID</key>
				<string>swanpanel-client-david-iphone-16-pro</string>
				<key>ExtendedAuthEnabled</key>
				<integer>0</integer>
				<key>DeadPeerDetectionRate</key>
				<string>Medium</string>
				<key>DisableMOBIKE</key>
				<integer>0</integer>
				<key>DisableRedirect</key>
				<integer>0</integer>
				<key>EnablePFS</key>
				<integer>1</integer>
				<key>EnableCertificateRevocationCheck</key>
				<integer>0</integer>
			</dict>
		</dict>
	</array>
</dict>
</plist>