[Unit]
Description=SwanPanel - Zero-Trust strongSwan VPN Control Plane
Documentation=https://github.com/thienvu18/swan-panel
After=network-online.target strongswan.service strongswan-starter.service ipsec.service
Wants=network-online.target
RequiresMountsFor=/var/lib/swan-panel /etc/swan-panel

[Service]
Type=simple
User=root
Group=root

# Environment and Execution
EnvironmentFile=-/etc/swan-panel/swan-panel.env
ExecStart=/usr/local/bin/swan-panel

# Process Management and Auto-Restart
Restart=always
RestartSec=3s
TimeoutStopSec=15s
KillMode=process

# Resource and Descriptor Limits
LimitNOFILE=65535
LimitNPROC=4096

# Security Hardening & Sandboxing (Least Privilege)
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=false
ProtectControlGroups=true
RestrictRealtime=true

# Structured Journal Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=swan-panel

[Install]
WantedBy=multi-user.target
