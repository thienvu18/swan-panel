{
  "name": "SwanPanel (Go + Vite + strongSwan)",
  "dockerComposeFile": "compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace/swan-panel",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "remoteUser": "root",
  "portsAttributes": {
    "3000": { "label": "Vite React HMR", "onAutoForward": "ignore" },
    "8080": { "label": "Go Air API", "onAutoForward": "ignore" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
